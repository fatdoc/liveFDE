  "components": {
    "schemas": {
      "FinalizeOutput": {
        "properties": {
          "material_id": {
            "type": "string",
            "format": "uuid",
            "title": "Material Id"
          },
          "status": {
            "type": "string",
            "const": "available",
            "title": "Status"
          },
          "sha256": {
            "type": "string",
            "title": "Sha256"
          },
          "size_bytes": {
            "type": "integer",
            "title": "Size Bytes"
          },
          "deduplicated": {
            "type": "boolean",
            "title": "Deduplicated"
          }
        },
        "type": "object",
        "required": [
          "material_id",
          "status",
          "sha256",
          "size_bytes",
          "deduplicated"
        ],
        "title": "FinalizeOutput"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "LinkInput": {
        "properties": {
          "material_id": {
            "type": "string",
            "format": "uuid",
            "title": "Material Id"
          },
          "role": {
            "type": "string",
            "enum": [
              "primary",
              "reference"
            ],
            "title": "Role"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "material_id",
          "role"
        ],
        "title": "LinkInput"
      },
      "LinkOutput": {
        "properties": {
          "session_id": {
            "type": "string",
            "format": "uuid",
            "title": "Session Id"
          },
          "material_id": {
            "type": "string",
            "format": "uuid",
            "title": "Material Id"
          },
          "role": {
            "type": "string",
            "enum": [
              "primary",
              "reference"
            ],
            "title": "Role"
          },
          "already_linked": {
            "type": "boolean",
            "title": "Already Linked"
          }
        },
        "type": "object",
        "required": [
          "session_id",
          "material_id",
          "role",
          "already_linked"
        ],
        "title": "LinkOutput"
      },
      "LoginRequest": {
        "properties": {
          "username": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Username"
          },
          "password": {
            "type": "string",
            "maxLength": 1024,
            "minLength": 1,
            "title": "Password"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "username",
          "password"
        ],
        "title": "LoginRequest"
      },
      "LoginResponse": {
        "properties": {
          "user": {
            "$ref": "#/components/schemas/UserView"
          },
          "csrf_token": {
            "type": "string",
            "title": "Csrf Token"
          }
        },
        "type": "object",
        "required": [
          "user",
          "csrf_token"
        ],
        "title": "LoginResponse"
      },
      "MaterialOutput": {
        "properties": {
          "material_id": {
            "type": "string",
            "format": "uuid",
            "title": "Material Id"
          },
          "status": {
            "type": "string",
            "const": "available",
            "title": "Status"
          },
          "filename": {
            "type": "string",
            "title": "Filename"
          },
          "purpose": {
            "type": "string",
            "enum": [
              "session_media",
              "transcript",
              "reference_pdf"
            ],
            "title": "Purpose"
          },
          "media_type": {
            "type": "string",
            "title": "Media Type"
          },
          "sha256": {
            "type": "string",
            "title": "Sha256"
          },
          "size_bytes": {
            "type": "integer",
            "title": "Size Bytes"
          },
          "is_speech_evidence": {
            "type": "boolean",
            "const": false,
            "title": "Is Speech Evidence"
          }
        },
        "type": "object",
        "required": [
          "material_id",
          "status",
          "filename",
          "purpose",
          "media_type",
          "sha256",
          "size_bytes",
          "is_speech_evidence"
        ],
        "title": "MaterialOutput"
      },
      "ReceiveOutput": {
        "properties": {
